{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch --unstable-kv main.ts",
    "start": "deno run --allow-net --allow-env --unstable-kv main.ts",
    "test": "deno test --allow-env --unstable-kv test.mjs && echo '--- integration ---' && node integration_node.cjs",
    "test:unit": "deno test --allow-env --unstable-kv test.mjs",
    "test:integration": "node integration_node.cjs",
    "check": "deno check main.ts",
    "deploy": "./deploy.sh"
  },
  "imports": {
    "hono": "jsr:@hono/hono@4.13.7",
    "std/": "https://deno.land/std@0.224.0/"
  }
}
